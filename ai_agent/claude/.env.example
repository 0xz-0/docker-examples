# 复制为 .env 后按需填写：cp .env.example .env
# Compose 会自动读取同目录的 .env；其中变量供 docker-compose.yaml 的 ${VAR:-default} 使用。
# 注意：若挂载的 claude-config/settings.json 里写了同名 env，会覆盖这里的值。

# ── 鉴权（二选一）─────────────────────────────────
# ① 官方直连：填 ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# ② 第三方网关：填下面两个（并把上面的 ANTHROPIC_API_KEY 留空）
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=

# ── 挂载卷的宿主机路径（可选，留空则用默认）──────────
# 默认 ./workspace 和 ./claude-config（相对 compose 文件所在目录）
WORKSPACE_DIR=
CLAUDE_CONFIG_DIR=
